# Environment variables for CIVICLENS AI
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=generate_a_random_secure_hex_token_for_production
DATABASE_URL=sqlite:///instance/civiclens_dev.db

# Security Settings
SESSION_COOKIE_SECURE=False
MAX_CONTENT_LENGTH=5242880

# AI Model settings
AI_CONFIDENCE_THRESHOLD=0.55
